# Copie para .env (que está no .gitignore). Valores apenas para desenvolvimento local.
# Referência completa: docs/DEPLOYMENT.md §2 e docs/DATABASE.md §7.

# PostgreSQL do docker compose
POSTGRES_USER=blastgrid
POSTGRES_PASSWORD=blastgrid_dev
POSTGRES_DB=blastgrid
BG_DB_PORT=5432

# API
BG_ENV=dev
BG_HTTP_PORT=8080
BG_LOG_LEVEL=info
BG_LOG_FORMAT=json
BG_DB_MAX_CONNS=10
BG_DB_MIN_CONNS=1
BG_SHUTDOWN_TIMEOUT=30s

# Para rodar a API fora do container (cd server && go run ./cmd/api) com o banco do compose:
# BG_DATABASE_URL=postgres://blastgrid:blastgrid_dev@localhost:5432/blastgrid?sslmode=disable
# BG_MIGRATE_ON_START=true

# Testes de integração (go test ./...) — opcional; sem ela os testes de banco são pulados:
# BG_TEST_DATABASE_URL=postgres://blastgrid:blastgrid_dev@localhost:5432/blastgrid?sslmode=disable
